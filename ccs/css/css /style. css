
/* ICT 2102 WEEK 5 - GROUP 4
   Community Knowledge Library stylesheet */

/* 1. General page appearance */
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
    margin: 0;
    color: #243447;
    background-color: #f1f5f9;
}

/* 2. Header and unique ID selector */
header {
    background: linear-gradient(135deg, #12344d, #247ba0);
    color: #ffffff;
    text-align: center;
    padding: 32px 16px;
}

#library-title {
    font-size: clamp(1.7rem, 5vw, 2.7rem);
    margin: 0 0 8px;
    letter-spacing: 0.5px;
}

header p {
    margin: 5px 0;
}

/* 3. Navigation and hover effects */
nav {
    background-color: #102f43;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    padding: 12px;
}

nav a {
    color: #ffffff;
    text-decoration: none;
    padding: 9px 13px;
    border-radius: 5px;
    transition: background-color 0.25s ease;
}

nav a:hover,
nav a:focus {
    background-color: #287ca5;
    color: #ffffff;
}

/* 4. Main content and reusable sections */
main {
    width: min(1100px, 100%);
    margin: 24px auto;
    padding: 0 16px;
}

section,
.form-card {
    background-color: #ffffff;
    margin-bottom: 24px;
    padding: 22px;
    border: 1px solid #dce5ec;
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(20, 50, 70, 0.06);
}

/* 5. Headings and paragraphs */
h1,
h2,
h3 {
    line-height: 1.3;
}

h2 {
    color: #174a6e;
    border-bottom: 2px solid #d7e8f1;
    padding-bottom: 8px;
}

h3 {
    color: #246b8e;
}

p {
    margin: 12px 0;
}

/* 6. Reusable classes for library items */
.book,
.service,
.resource,
.course,
.important {
    padding: 14px;
    margin: 12px 0;
    border-radius: 6px;
}

.book,
.resource {
    background-color: #f0f7fb;
    border-left: 4px solid #287ca5;
}

.service,
.course {
    background-color: #f5f8f5;
    border-left: 4px solid #4d8764;
}

.important {
    background-color: #fff7df;
    border-left: 4px solid #d99b19;
}

/* 7. Lists */
ul,
ol {
    padding-left: 28px;
}

li {
    margin-bottom: 7px;
}

li::marker {
    color: #247ba0;
}

/* 8. Images and gallery */
img {
    max-width: 100%;
    height: auto;
}

main img {
    border-radius: 8px;
}

.gallery {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 16px;
}

.gallery img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    border: 2px solid #dce5ec;
    transition: transform 0.25s ease;
}

.gallery img:hover {
    transform: scale(1.02);
}

/* 9. Tables */
.table-container {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
    background-color: #ffffff;
}

th,
td {
    border: 1px solid #d1dbe3;
    padding: 12px;
    text-align: left;
}

th {
    background-color: #174a6e;
    color: #ffffff;
}

tbody tr:nth-child(even) {
    background-color: #f0f6fa;
}

tbody tr:hover {
    background-color: #e1f0f7;
}

/* 10. Forms and fieldsets */
form {
    width: 100%;
}

fieldset {
    border: 1px solid #cbd8e1;
    border-radius: 7px;
    padding: 16px;
    margin: 0 0 20px;
    min-width: 0;
}

legend {
    color: #174a6e;
    font-weight: bold;
    padding: 0 6px;
}

label {
    display: block;
    font-weight: 600;
    margin: 12px 0 5px;
}

input,
select,
textarea {
    font: inherit;
    width: 100%;
    max-width: 100%;
    padding: 11px;
    border: 1px solid #b9c8d4;
    border-radius: 5px;
    background-color: #ffffff;
    color: #243447;
}

input[type="radio"],
input[type="checkbox"] {
    width: auto;
    margin-right: 8px;
    accent-color: #174a6e;
}

label.option {
    display: flex;
    align-items: center;
    gap: 5px;
    font-weight: normal;
    margin: 10px 0;
}

label.option input {
    flex-shrink: 0;
}

input:focus,
select:focus,
textarea:focus {
    outline: 2px solid #5ba8d0;
    outline-offset: 2px;
}

textarea {
    resize: vertical;
}

/* 11. Buttons and hover effects */
button,
input[type="submit"],
input[type="reset"] {
    width: auto;
    max-width: 100%;
    padding: 11px 18px;
    margin: 6px 5px 6px 0;
    border: none;
    border-radius: 5px;
    background-color: #174a6e;
    color: #ffffff;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.25s ease;
}

button:hover,
input[type="submit"]:hover {
    background-color: #287ca5;
}

input[type="reset"] {
    background-color: #596b78;
}

input[type="reset"]:hover {
    background-color: #394b58;
}

/* 12. Audio and video */
audio,
video {
    display: block;
    width: 100%;
    max-width: 650px;
    margin: 16px auto;
    border-radius: 8px;
}

/* 13. Links */
a {
    color: #17658c;
}

main a:hover {
    color: #0c3d59;
}

/* 14. Footer */
footer {
    background-color: #102f43;
    color: #ffffff;
    text-align: center;
    padding: 24px 16px;
    margin-top: 30px;
}

footer a {
    color: #d7efff;
}

footer a:hover {
    color: #ffffff;
}

/* 15. Fine calculator result */
#result {
    padding: 12px;
    background-color: #eaf4f9;
    border-left: 4px solid #247ba0;
    border-radius: 5px;
    font-weight: bold;
}

/* 16. Responsive design for small screens */
@media (max-width: 600px) {
    header {
        padding: 24px 12px;
    }

    nav {
        flex-direction: column;
        align-items: stretch;
    }

    nav a {
        text-align: center;
    }

    main {
        margin: 14px auto;
        padding: 0 10px;
    }

    section,
    .form-card {
        padding: 15px;
    }

    th,
    td {
        padding: 8px;
        font-size: 0.9rem;
    }

    .gallery img {
        height: 170px;
    }

    button,
    input[type="submit"],
    input[type="reset"] {
        margin-bottom: 8px;
    }
}
